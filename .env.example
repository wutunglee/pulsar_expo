# 複製成 .env 後填入。.env 不進版控。
SECRET_KEY=請換成一串長亂數
DEV_MODE=0

# LINE（LINE Developers 後台）
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=
LINE_OA_ID=@201nygdf

# 攤位核銷頁與統計頁
