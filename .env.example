# 複製成 .env 後填入。.env 不進版控。
SECRET_KEY=請換成一串長亂數
DEV_MODE=0

# 對外網址（官方帳號回傳的專屬連結會用到），結尾不要斜線
PUBLIC_URL=https://expo.pulsarpump.com
LINE_OA_ID=@201nygdf

# 認人方式：oa＝官方帳號 webhook 發專屬連結（預設）；liff＝LINE Login／LIFF
IDENTITY=oa
# 好友確認：oa＝webhook 的加入／封鎖通知；line＝LIFF 開卡時向 LINE 查（需 IDENTITY=liff）；
# staff＝攤位人員看過手機後按確認。留空時跟著 IDENTITY 走。
FRIEND_CHECK=

# IDENTITY=oa 用：官方帳號那個 Messaging API 頻道的 Channel ID 與 Channel secret
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_KEYWORD=任務卡

# IDENTITY=liff 用
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# 攤位核銷頁與統計頁
STAFF_PIN=
ADMIN_TOKEN=

# 現場優惠券上顯示的文字（到攤位報到後才出現），例如：現場消費折 100 元
ONSITE_OFFER=
# 領了券但沒到攤位的人，活動結束後看到的官網折扣碼（先在 WooCommerce 建立）
COUPON_ABSENT=

# 選填：資料庫位置，預設 data/expo.db
# DB_PATH=/var/lib/pulsar_expo/expo.db
